{
  "name": "@lgtm-hq/turbo-themes-core",
  "version": "0.11.0",
  "description": "Core design tokens and theme definitions for Turbo Themes",
  "license": "MIT",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/themes/metadata.d.ts",
      "import": "./dist/themes/metadata.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./native-theme": {
      "types": "./dist/native-theme/index.d.ts",
      "import": "./dist/native-theme/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./catalog.json": "./dist/catalog/catalog.json",
    "./themes": {
      "types": "./dist/themes/registry.d.ts",
      "import": "./dist/themes/registry.js"
    },
    "./themes/types": {
      "types": "./dist/themes/types.d.ts",
      "import": "./dist/themes/types.js"
    },
    "./css/mappings": {
      "types": "./dist/themes/css/mappings.d.ts",
      "import": "./dist/themes/css/mappings.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
